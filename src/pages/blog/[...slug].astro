---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { visibile } from '../../lib/utils';

// Componenti disponibili dentro i post senza doverli importare ogni volta.
import YouTube from '../../components/YouTube.astro';
import Figure from '../../components/Figure.astro';
import Audio from '../../components/Audio.astro';
import Video from '../../components/Video.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const post = (await getCollection('posts')).filter(visibile);
  return post.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout {post}>
  <Content components={{ YouTube, Figure, Audio, Video }} />
</PostLayout>
