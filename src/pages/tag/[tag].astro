---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { link, perDataDecrescente, elencabile } from '../../lib/utils';

export const getStaticPaths: GetStaticPaths = async () => {
  const post = (await getCollection('posts')).filter(elencabile);
  const etichette = [...new Set(post.flatMap((p) => p.data.tags))];

  return etichette.map((tag) => ({
    params: { tag },
    props: {
      post: post.filter((p) => p.data.tags.includes(tag)).sort(perDataDecrescente),
    },
  }));
};

const { tag } = Astro.params;
const { post } = Astro.props;
---

<Base title={`Post etichettati “${tag}”`} noindex>
  <h1>{tag}</h1>
  <p class="introduzione">
    {post.length === 1 ? 'Un post' : `${post.length} post`} con questa etichetta.
    <a href={link('/blog')}>Tutti i post</a>.
  </p>

  <ul class="elenco">
    {post.map((p) => <PostCard post={p} />)}
  </ul>
</Base>
