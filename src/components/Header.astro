---
import { site, activeSections } from '../site.config';
import { link } from '../lib/utils';
import ThemeToggle from './ThemeToggle.astro';

// Il menu si costruisce da solo: le sezioni collaterali compaiono
// soltanto se attive in site.config.ts
// `titolo` serve quando l'etichetta da sola non si spiega: chi naviga con un
// lettore di schermo sentirebbe soltanto "punto interrogativo".
const voci: { href: string; label: string; titolo?: string }[] = [
  { href: link('/blog'), label: 'Blog' },
  ...activeSections.map((s) => ({ href: link(`/${s.slug}`), label: s.label })),
  {
    href: link('/cos-e-questo-micro-blog'),
    label: '?',
    titolo: "Cos'è questo micro-blog",
  },
];

const percorso = Astro.url.pathname.replace(/\/$/, '');
const attivo = (href: string) => {
  const h = href.replace(/\/$/, '');
  return percorso === h || percorso.startsWith(`${h}/`);
};
---

<header class="testata">
  <div class="contenitore contenitore--ampio testata__interno">
    <p class="testata__titolo">
      <a href={link('/')}>{site.title}</a>
    </p>
    <nav class="menu" aria-label="Navigazione principale">
      {
        voci.map((v) => (
          <a
            href={v.href}
            aria-current={attivo(v.href) ? 'page' : undefined}
            aria-label={v.titolo}
            title={v.titolo}
          >
            {v.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
