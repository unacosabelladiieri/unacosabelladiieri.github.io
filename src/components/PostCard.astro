---
/** Una voce nell'elenco dei post. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { link, dataEstesa, dataISO } from '../lib/utils';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, description, tags, draft, cover, coverAlt } = post.data;
const indirizzo = link(`/blog/${post.id}`);
---

<li>
  <article class:list={['voce', cover && 'voce--con-anteprima']}>
    <div class="voce__testo">
      <time class="data" datetime={dataISO(date)}>{dataEstesa(date)}</time>
      {draft && <span class="bozza">bozza</span>}
      <h2 class="voce__titolo">
        <a href={indirizzo}>{title}</a>
      </h2>
      {description && <p class="voce__descrizione">{description}</p>}
      {
        tags.length > 0 && (
          <ul class="etichette">
            {tags.map((t) => (
              <li>
                <a href={link(`/tag/${t}`)}>{t}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      cover && (
        <a class="voce__anteprima" href={indirizzo} tabindex="-1" aria-hidden="true">
          <Image src={cover} alt={coverAlt ?? ''} width={240} loading="lazy" />
        </a>
      )
    }
  </article>
</li>

<style>
  /* senza copertina la voce resta esattamente com'era */
  .voce--con-anteprima {
    display: grid;
    grid-template-columns: 1fr 96px;
    gap: 1.25rem;
    align-items: start;
  }

  .voce__anteprima {
    display: block;
    border-radius: var(--raggio);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--sfondo-tenue);
    /* allineata alla riga della data, non al bordo del blocco */
    margin-top: 0.35rem;
  }

  .voce__anteprima img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }

  .voce:hover .voce__anteprima img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .voce__anteprima img {
      transition: none;
    }
  }

  @media (max-width: 30rem) {
    .voce--con-anteprima {
      grid-template-columns: 1fr 72px;
      gap: 1rem;
    }
  }

  .bozza {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accento);
    border: 1px solid var(--accento);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    margin-left: 0.5rem;
  }
</style>
