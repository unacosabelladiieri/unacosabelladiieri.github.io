---
/**
 * Modulo di iscrizione alla newsletter (Buttondown).
 *
 * È un form HTML e nient'altro: nessuno script di terzi, nessun cookie.
 * L'indirizzo parte solo quando qualcuno preme "Iscriviti".
 *
 * Il modulo si apre in una scheda nuova e non viene inviato di nascosto
 * perché Buttondown, per difendersi dai programmi automatici, mostra una
 * pagina con un tasto "Verify and Subscribe" da premere a mano: senza quel
 * passaggio l'iscrizione non si completa. Chi legge, intanto, non perde il
 * segno nella pagina.
 *
 * Le impostazioni stanno in src/site.config.ts, sotto `newsletter`.
 */
import { newsletter } from '../site.config';
import { link } from '../lib/utils';

const attivo = Boolean(newsletter.utente);
// l'endpoint giusto è "embed-subscribe": "subscribe" risponde 404
const azione = `https://buttondown.com/api/emails/embed-subscribe/${newsletter.utente}`;
---

{
  attivo && (
    <section class="iscriviti">
      <p class="iscriviti__invito">{newsletter.invito}</p>

      <form class="iscriviti__form" action={azione} method="post" target="_blank">
        <label class="sr" for="email-iscrizione">
          Il tuo indirizzo email
        </label>
        <input
          class="iscriviti__campo"
          id="email-iscrizione"
          type="email"
          name="email"
          placeholder="la tua email"
          autocomplete="email"
          required
        />
        <input type="hidden" name="embed" value="1" />
        <button class="iscriviti__tasto" type="submit">
          Iscriviti
        </button>
      </form>

      <p class="iscriviti__nota">
        Si apre una scheda dove confermare, poi arriva una mail di verifica da
        cliccare: <strong>controlla anche nella posta indesiderata</strong>, è lì
        che finisce quasi sempre. Senza quel clic l'iscrizione resta a metà e non
        ti arriva niente.
      </p>
      <p class="iscriviti__nota">
        Poi più nulla, se non un avviso quando pubblico; ci si cancella quando si
        vuole. In alternativa c'è il <a href={link('/rss.xml')}>feed RSS</a>, che
        non chiede né email né conferme.
      </p>
    </section>
  )
}

<style>
  .iscriviti {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--bordo);
  }

  .iscriviti__invito {
    margin: 0 0 0.9rem;
    font-size: 1rem;
  }

  .iscriviti__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .iscriviti__campo {
    flex: 1 1 15rem;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    padding: 0.5rem 0.7rem;
    color: var(--testo);
    background: var(--sfondo);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
  }

  .iscriviti__campo:focus {
    border-color: var(--accento);
  }

  .iscriviti__tasto {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    padding: 0.5rem 1.1rem;
    color: var(--sfondo);
    background: var(--accento);
    border: 1px solid var(--accento);
    border-radius: var(--raggio);
    cursor: pointer;
  }

  .iscriviti__tasto:hover {
    background: var(--accento-tenue);
    border-color: var(--accento-tenue);
  }

  .iscriviti__nota {
    margin: 0.75rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--testo-tenue);
  }

  .iscriviti__nota + .iscriviti__nota {
    margin-top: 0.5rem;
  }

  .iscriviti__nota strong {
    color: var(--testo);
    font-weight: 600;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
