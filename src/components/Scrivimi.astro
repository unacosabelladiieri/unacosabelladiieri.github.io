---
/**
 * Modulo di contatto, appoggiato a Web3Forms.
 *
 * L'indirizzo di destinazione non è scritto da nessuna parte nella pagina:
 * lo conosce solo Web3Forms, che inoltra i messaggi. Nel sito resta la
 * chiave, che di per sé non rivela nulla.
 *
 * Funziona anche senza JavaScript (il modulo viene inviato normalmente e
 * si finisce su una pagina di conferma di Web3Forms); con JavaScript
 * attivo resta tutto qui, con un messaggio di esito.
 */
import { contatto, site } from '../site.config';

const attivo = Boolean(contatto.chiave);
---

{
  attivo && (
    <section class="scrivimi" id="scrivimi">
      <h2 class="scrivimi__titolo">Scrivimi</h2>
      <p class="scrivimi__invito">{contatto.invito}</p>

      <form class="scrivimi__form" action="https://api.web3forms.com/submit" method="post">
        <input type="hidden" name="access_key" value={contatto.chiave} />
        <input type="hidden" name="subject" value={`Messaggio da ${site.title}`} />
        <input type="hidden" name="from_name" value={site.title} />
        {/* campo esca: i programmi automatici lo riempiono, le persone no */}
        <input type="checkbox" name="botcheck" class="sr" tabindex="-1" autocomplete="off" />

        <div class="scrivimi__riga">
          <label for="contatto-nome">Come ti chiami</label>
          <input id="contatto-nome" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="scrivimi__riga">
          <label for="contatto-email">La tua email</label>
          <input id="contatto-email" name="email" type="email" autocomplete="email" required />
          <span class="scrivimi__aiuto">Serve solo perché possa risponderti.</span>
        </div>

        <div class="scrivimi__riga">
          <label for="contatto-messaggio">Il messaggio</label>
          <textarea id="contatto-messaggio" name="message" rows="5" required />
        </div>

        <div class="scrivimi__fondo">
          <button type="submit">Invia</button>
          <span class="scrivimi__esito" role="status" aria-live="polite" />
        </div>
      </form>
    </section>
  )
}

<style>
  .scrivimi {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--bordo);
  }

  .scrivimi__titolo {
    font-size: 1.15rem;
    margin-top: 0;
  }

  .scrivimi__invito {
    color: var(--testo-tenue);
    margin-bottom: 1.5rem;
  }

  .scrivimi__form {
    display: grid;
    gap: 1.1rem;
  }

  .scrivimi__riga {
    display: grid;
    gap: 0.3rem;
  }

  .scrivimi__riga label {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--testo-tenue);
  }

  .scrivimi__aiuto {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--testo-tenue);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    padding: 0.5rem 0.7rem;
    color: var(--testo);
    background: var(--sfondo);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--accento);
    outline: none;
  }

  .scrivimi__fondo {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  button {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    padding: 0.5rem 1.3rem;
    color: var(--sfondo);
    background: var(--accento);
    border: 1px solid var(--accento);
    border-radius: var(--raggio);
    cursor: pointer;
  }

  button:hover {
    background: var(--accento-tenue);
    border-color: var(--accento-tenue);
  }

  button[disabled] {
    opacity: 0.6;
    cursor: default;
  }

  .scrivimi__esito {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--accento);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.scrivimi__form');
  const esito = document.querySelector<HTMLElement>('.scrivimi__esito');
  const tasto = form?.querySelector('button');

  form?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (!esito || !tasto) return;

    tasto.disabled = true;
    esito.textContent = 'Invio in corso…';

    try {
      const risposta = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      });

      if (risposta.ok) {
        form.reset();
        esito.textContent = 'Messaggio inviato, grazie.';
      } else {
        esito.textContent = 'Qualcosa non ha funzionato: riprova fra poco.';
      }
    } catch {
      esito.textContent = 'Messaggio non partito: controlla la connessione.';
    } finally {
      tasto.disabled = false;
    }
  });
</script>
