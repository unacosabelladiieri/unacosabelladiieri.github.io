---
/**
 * Video caricato direttamente (non YouTube).
 *
 *   <Video src="/video/mare.mp4" poster="/immagini/mare.jpg">Il mare a giugno</Video>
 *
 * I file vanno in `public/video/`. Attenzione al peso: GitHub Pages ha un
 * limite di 1 GB per repository e i file oltre i 100 MB vengono rifiutati.
 * Per video lunghi conviene caricarli su YouTube e usare <YouTube />.
 */
import { link } from '../lib/utils';

interface Props {
  src: string;
  /** immagine mostrata prima del play */
  poster?: string;
  /** riproduzione automatica silenziosa e in loop, tipo GIF */
  muto?: boolean;
}

const { src, poster, muto = false } = Astro.props;
const sorgente = src.startsWith('http') ? src : link(src);
---

<figure>
  <video
    src={sorgente}
    poster={poster ? link(poster) : undefined}
    controls
    playsinline
    preload="metadata"
    muted={muto}
    loop={muto}
    autoplay={muto}></video>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  video {
    width: 100%;
    height: auto;
    border-radius: var(--raggio);
    background: #000;
    display: block;
  }
</style>
