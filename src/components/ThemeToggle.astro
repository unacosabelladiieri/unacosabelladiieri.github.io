---
/**
 * Tasto per passare dal tema chiaro a quello scuro.
 *
 * Senza averlo mai premuto, il sito segue le impostazioni del sistema.
 * Al primo tocco la scelta viene salvata nel browser e ha la precedenza;
 * il tasto "Sistema" nel menu contestuale non serve — per tornare al
 * comportamento automatico basta cancellare i dati del sito.
 */
---

<button
  id="tasto-tema"
  type="button"
  class="tasto-tema"
  aria-label="Cambia tema"
  title="Cambia tema"
>
  {/* Cerchio mezzo pieno: la metà scura indica dove si va premendo.
      Non è una luna, così non si confonde con il sole eclissato del fregio. */}
  <svg class="icona icona--chiaro" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8"></circle>
    <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none"></path>
  </svg>
  <svg class="icona icona--scuro" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8"></circle>
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"></path>
  </svg>
</button>

<style>
  .tasto-tema {
    background: none;
    border: 1px solid transparent;
    border-radius: var(--raggio);
    color: var(--testo-tenue);
    cursor: pointer;
    padding: 0.3rem;
    line-height: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tasto-tema:hover {
    color: var(--testo);
    border-color: var(--bordo);
  }

  .icona {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* si mostra il verso corrispondente al tema in cui si andrà */
  .icona--chiaro {
    display: none;
  }

  :global(:root[data-theme='scuro']) .icona--chiaro {
    display: block;
  }

  :global(:root[data-theme='scuro']) .icona--scuro {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='chiaro'])) .icona--chiaro {
      display: block;
    }

    :global(:root:not([data-theme='chiaro'])) .icona--scuro {
      display: none;
    }
  }
</style>

<script>
  const CHIAVE = 'tema';

  const sistemaScuro = () =>
    window.matchMedia('(prefers-color-scheme: dark)').matches;

  /** Il tema che si vede adesso, comunque ci si sia arrivati. */
  const temaAttuale = (): 'chiaro' | 'scuro' => {
    const salvato = localStorage.getItem(CHIAVE);
    if (salvato === 'chiaro' || salvato === 'scuro') return salvato;
    return sistemaScuro() ? 'scuro' : 'chiaro';
  };

  const applica = (tema: 'chiaro' | 'scuro') => {
    document.documentElement.dataset.theme = tema;
    localStorage.setItem(CHIAVE, tema);

    // se i commenti sono caricati, cambiano tema anche loro
    const giscus = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    giscus?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: tema === 'scuro' ? 'dark' : 'light' } } },
      'https://giscus.app',
    );
  };

  document.getElementById('tasto-tema')?.addEventListener('click', () => {
    applica(temaAttuale() === 'scuro' ? 'chiaro' : 'scuro');
  });
</script>
