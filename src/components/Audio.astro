---
/**
 * Nota vocale o traccia audio.
 *
 *   <Audio src="/audio/nota-14-agosto.m4a" titolo="Nota vocale dal treno" />
 *
 * I file audio vanno messi in `public/audio/`: il percorso parte da lì.
 * Formati consigliati: .m4a (memo vocali iPhone), .mp3, .ogg, .wav.
 */
import { link } from '../lib/utils';

interface Props {
  src: string;
  titolo?: string;
  /** testo sotto al lettore: didascalia o trascrizione breve */
  nota?: string;
}

const { src, titolo, nota } = Astro.props;

// i percorsi assoluti passano dall'helper, quelli esterni restano intatti
const sorgente = src.startsWith('http') ? src : link(src);
---

<figure class="audio">
  {titolo && <p class="audio__titolo">{titolo}</p>}
  <audio controls preload="none" src={sorgente}>
    <a href={sorgente}>Scarica l'audio</a>
  </audio>
  {(nota || Astro.slots.has('default')) && (
    <figcaption>
      {nota}
      <slot />
    </figcaption>
  )}
</figure>

<style>
  .audio {
    margin-inline: 0;
    padding: 1rem 1.15rem;
    background: var(--sfondo-tenue);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
  }

  .audio__titolo {
    margin: 0 0 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 600;
  }

  audio {
    width: 100%;
    display: block;
  }

  figcaption {
    margin-top: 0.6rem;
    text-align: left;
  }
</style>
