---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import MathStyles from '../components/MathStyles.astro';
import Condividi from '../components/Condividi.astro';
import Iscriviti from '../components/Iscriviti.astro';
import { link, dataEstesa, dataISO } from '../lib/utils';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, updated, description, cover, coverAlt, tags, math } =
  post.data;
---

<Base
  {title}
  {description}
  article
  image={cover?.src}
  noindex={post.data.draft || post.data.unlisted}
>
  {math && <MathStyles />}

  <article>
    <header class="intestazione">
      <time class="data" datetime={dataISO(date)}>{dataEstesa(date)}</time>
      <h1>{title}</h1>
      {description && <p class="sommario">{description}</p>}
      {
        updated && (
          <p class="data aggiornato">
            Aggiornato il <time datetime={dataISO(updated)}>{dataEstesa(updated)}</time>
          </p>
        )
      }
    </header>

    {
      cover && (
        <Image
          class="copertina"
          src={cover}
          alt={coverAlt ?? ''}
          width={1000}
          loading="eager"
        />
      )
    }

    <div class="prosa">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <ul class="etichette etichette--fondo">
          {tags.map((t) => (
            <li>
              <a href={link(`/tag/${t}`)}>{t}</a>
            </li>
          ))}
        </ul>
      )
    }

    <Condividi
      titolo={title}
      url={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}
    />
  </article>

  {post.data.comments && <Comments />}

  {/* L'invito arriva per ultimo: chi ha letto il post e magari i commenti
      è la persona più disposta a lasciare il proprio indirizzo. */}
  <Iscriviti />
</Base>

<style>
  .intestazione {
    margin-bottom: 2rem;
  }

  .intestazione h1 {
    margin-block: 0.4rem 0;
  }

  .sommario {
    color: var(--testo-tenue);
    font-size: 1.05rem;
    margin-block: 0.75rem 0;
  }

  .aggiornato {
    margin-top: 0.75rem;
  }

  .copertina {
    width: 100%;
    height: auto;
    border-radius: var(--raggio);
    margin-bottom: 2rem;
  }

  .etichette--fondo {
    margin-top: 3rem;
  }
</style>
